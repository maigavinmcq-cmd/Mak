IMAGE_API_KEY=
VIDEO_API_KEY=

# 图生图 SOP 只给出 /v1/images/generations，必须填写真实 API 域名。
IMAGE_API_BASE_URL=https://YOUR_API_HOST

# 以下值按 SOP 默认，可按实际账号能力调整。
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024

# 可选：如果图生图只返回 b64，需要上传到公网后才能调用 JimmyAI 视频接口。
# 上传接口需返回 url/image_url/data.url/data.image_url 等字段之一。
IMAGE_UPLOAD_API_URL=
IMAGE_UPLOAD_API_KEY=
IMAGE_UPLOAD_FILE_FIELD=file

VIDEO_API_BASE_URL=https://xibapi.com
VIDEO_MODEL=veo_3_1-fast-fl
VIDEO_SIZE=1080x1920
